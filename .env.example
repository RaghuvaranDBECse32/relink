# Copy to .env and export (or set in Cloud Run / Secret Manager). Never commit real keys.
PORT=8080
RELINK_SECRET=            # long random string; token-signing key (auto-generated into data/.secret if empty)
RETENTION_DAYS=0          # delete messages older than N days at startup (0 = keep)
TAVILY_API_KEY=           # enables live evidence retrieval in Verify
BIFROST_BASE_URL=         # e.g. http://localhost:8080 (Bifrost gateway); routes the judge model
BIFROST_API_KEY=          # optional, if your gateway requires it
BIFROST_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=           # direct Gemini fallback when Bifrost is not set
GEMINI_MODEL=gemini-2.5-flash
