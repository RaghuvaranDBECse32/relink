# --- Backend ---
DATABASE_URL=postgresql://safestudy:safestudy@localhost:5432/safestudy
JWT_SECRET=generate-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:5173

# Gemini (https://aistudio.google.com/apikey). Leave blank to run in offline-fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# "hash" works offline (lexical). "sentence-transformers" = real semantic embeddings
# (uncomment sentence-transformers in backend/requirements.txt first).
EMBEDDING_BACKEND=hash

# Optional extra output guardrail
ENKRYPT_API_KEY=
